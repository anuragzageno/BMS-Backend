        <!-- Insert sample bookings for dance rooms -->
        <insert tableName="bookings">
            <column name="dance_room_id" value="1"/>
            <column name="user_id" value="1"/>
            <column name="customer_name" value="John Doe"/>
            <column name="customer_email" value="john.doe@example.com"/>
            <column name="customer_phone" value="+1-555-0123"/>
            <column name="booking_date" value="2024-12-01"/>
            <column name="start_time" value="18:00:00"/>
