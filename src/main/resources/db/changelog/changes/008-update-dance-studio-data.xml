<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="008" author="studio-booking">
        <!-- Clear existing courts data -->
        <delete tableName="bookings"/>
        <delete tableName="dance_rooms"/>
        
        <!-- Update studio data to be dance studios -->
        <update tableName="studios">
            <column name="name" value="Elite Dance Academy"/>
            <column name="description" value="Premier dance studio with professional-grade rooms for all dance styles"/>
            <column name="facilities" value="AC Rooms, Mirrors, Sound System, Changing Rooms, Parking"/>
            <column name="pricing_info" value="Starting from ₹800/hour"/>
            <where>id = 1</where>
        </update>

        <update tableName="studios">
            <column name="name" value="Rhythm Dance Hub"/>
            <column name="description" value="Modern dance studio with multiple rooms for dance training and performances"/>
            <column name="facilities" value="Multiple Rooms, Sound System, Mirrors, Air Conditioning"/>
            <column name="pricing_info" value="Starting from ₹600/hour"/>
            <where>id = 2</where>
        </update>

        <update tableName="studios">
            <column name="name" value="Motion Dance Studio"/>
            <column name="description" value="Professional dance studio with specialized rooms for various dance forms"/>
            <column name="facilities" value="Professional Rooms, Recording Setup, Sound System, Video Equipment"/>
            <column name="pricing_info" value="Starting from ₹1000/hour"/>
            <where>id = 3</where>
        </update>

        <!-- Insert sample dance rooms -->
        <insert tableName="dance_rooms">
