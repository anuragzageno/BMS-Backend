        <insert tableName="dance_rooms">
            <column name="studio_id" value="3"/>
            <column name="name" value="Premium Big Hall"/>
            <column name="room_type" value="BIG_HALL"/>
            <column name="hourly_rate" value="1000.00"/>
            <column name="capacity" value="24"/>
