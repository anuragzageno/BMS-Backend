<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="005" author="studio-booking">
        <!-- Rename courts table to dance_rooms -->
        <renameTable oldTableName="courts" newTableName="dance_rooms"/>
        
        <!-- Rename court_type column to room_type -->
        <renameColumn tableName="dance_rooms" oldColumnName="court_type" newColumnName="room_type"/>
        
        <!-- Update foreign key constraint in bookings table -->
        <dropForeignKeyConstraint baseTableName="bookings" constraintName="fk_booking_court"/>
        <renameColumn tableName="bookings" oldColumnName="court_id" newColumnName="dance_room_id"/>
        <addForeignKeyConstraint 
            baseTableName="bookings" 
            baseColumnNames="dance_room_id" 
            constraintName="fk_booking_dance_room" 
            referencedTableName="dance_rooms" 
            referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>